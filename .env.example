DATABASE_URL=mysql://knicks:knicks@127.0.0.1:3307/knicks
HOST=127.0.0.1
PORT=3000
# Minutes between background syncs from ESPN while the server runs. 0 turns it off.
SYNC_INTERVAL_MINUTES=60
# What "Check for new games" (POST /api/sync) must present. Empty turns that route off;
# the server still syncs at startup and on the timer. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SYNC_SECRET=
