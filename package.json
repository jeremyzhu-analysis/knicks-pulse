{
  "name": "knicks-pulse",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "node server/main.ts serve",
    "migrate": "node server/main.ts migrate",
    "sync": "node server/main.ts sync",
    "export": "node server/main.ts export",
    "tunnel": "node server/tunnel.ts",
    "dev": "vite web",
    "build": "vite build web",
    "typecheck": "tsc -p web && tsc -p server",
    "test": "node --test \"server/**/*.test.ts\"",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.2",
    "fastify": "5.12.8",
    "mysql2": "3.24.6",
    "typebox": "1.4.6"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=26.13.1",
    "npm": ">=12.2.2"
  }
}
